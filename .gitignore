# Dev journal — Layer A auto-capture (experimental; raw trail, not handover)
docs/dev-journal/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest-work/
.mypy_cache/
.ruff_cache/
.coverage
backend/.coverage
.venv/
backend/.venv/

# Service run scripts — local logs/pids, not committed
.service-logs/
.service-pids/

# Local/dev inspection-photo storage (round 13) — never committed
backend/var/

# Per-project config & secrets — generated by setup, never commit
project.config
.env
.env.*
!.env.example
# backend/.env.prod.example — a placeholder-only production reference (see
# its own header comment: "DO NOT commit ค่าจริง"), the same class of file
# as .env.example above; `.env.*` on its own would otherwise also catch and
# hide this one.
!.env.prod.example
backend.env.generated
frontend.env.generated

# Claude Code local state — ignore everything except shared project skills
.claude/*
!.claude/skills/
!.claude/skills/**
# …but never Python bytecode caches that land inside skills/ (the re-include
# above would otherwise un-ignore them, leaving __pycache__ dirs untracked).
.claude/skills/**/__pycache__/

# Node
node_modules/
frontend/dist/

# Old standalone review doc (round: Git UAT initial push) — kept locally as
# a reference, deliberately removed from the git index (not deleted): it
# predates this repo's own history and isn't meant to ship with the source.
docs/SRM_FieldInspect_App_Review_2026-07-06.docx

# Generated PDF artifacts — rebuilt from .md via scripts/build-*-pdf.py.
# Not committed (regenerate on demand) and never shipped into generated projects
# (they document the STANDARD itself, not the user's app). cleanup-after-setup.py
# strips any that a filesystem copy dragged in.
docs/*.pdf

# Compat patches for already-generated projects. Throwaway one-off fixes stay
# local-only (scaffold templates already carry those fixes). Shipped exceptions:
# opt-in *module* patches that existing projects need to adopt a new feature
# (e.g. v3.1.0 Database Connections) + the README that documents them.
patches/*
!patches/README.md
!patches/v3_1_0_db_connections_patch.py

# Pytest scratch/output dirs — ad-hoc QA/audit script runs create these
# (some end up owner/permission-restricted, e.g. from a container-run
# script), never source. Covers both the bare dir and every suffixed
# variant (`.pytest_tmp_codex_881`, `.pytest_tmp_scope_review`, …).
backend/.pytest_tmp/
backend/.pytest_tmp_*/

# Generated Excel/report artifacts and sample outputs from Plot Import QA —
# regenerate on demand, never committed (same rule as any other generated
# Excel in this project).
artifacts/
outputs/

# Scratch scripts (one-off QA/debug scripts run against a live container or
# DB, e.g. round 8-21C's Excel-preview scripts) — not source.
backend/scratchpad/
scratchpad/

# Stray junk file from a Windows `> nul` redirect mistake in some earlier
# command (not `/dev/null`) — harmless, but not source. Left in place
# locally rather than deleted; just never committed.
backend/nul

# Claude Code local state can appear in any subdirectory the tool was run
# from, not just the repo root (the `.claude/*` rule above is anchored to
# root only, per git's own rules for a mid-pattern slash).
frontend/.claude/

# OS
.DS_Store
Thumbs.db
desktop.ini
