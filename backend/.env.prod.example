# backend/.env.prod.example — ตัวอย่างค่า production
# วิธีใช้: คัดลอกไปเป็น backend/.env บน production server แล้วแก้ค่าจริง
#   cp backend/.env.prod.example backend/.env
# backend/.env ถูก gitignore อยู่แล้ว — DO NOT commit ค่าจริง

APP_NAME=srm-fieldinspect
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO

API_CORS_ORIGINS=https://<your-production-domain>

# Production DB — centralized server (ไม่ใช่ localhost)
DB_HOST=<centralized-db-hostname>
DB_PORT=5432
DB_NAME=srm_fieldinspect
DB_USER=srm_fieldinspect
DB_PASSWORD=<strong-password-from-vault>
# ⚠️ NOT YET APPROVED FOR PRODUCTION (round 8-16D.1).
# These are the DEV defaults carried over, not a sized configuration.
#
# The image runs `uvicorn --workers 4`, and app/main.py's lifespan builds one
# engine PER WORKER, so the ceiling is:
#
#     max_db_connections = workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
#
# With the values below that is 4 x (10 + 20) = 120 connections from this app
# alone, before alembic (which opens its own sync psycopg connection during
# deploy) and before any other application sharing the same server.
#
# Postgres defaults to max_connections=100, minus superuser_reserved_connections
# (default 3), so ~97 are usable — i.e. these values can exhaust a
# default-configured server and surface as "FATAL: sorry, too many clients".
#
# Do NOT guess. Get the real max_connections, CPU/RAM, and whether other
# applications share the server from Infra, then choose ONE of: raise
# max_connections, lower these two values, reduce worker count, or put
# PgBouncer in front. See docs/deployment.md §5.0-pre.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Azure AD
AZURE_AD_TENANT_ID=<from-azure-portal>
AZURE_AD_CLIENT_ID=<from-azure-portal>
AZURE_AD_CLIENT_SECRET=<from-azure-portal>

# JWT
JWT_SECRET_KEY=<generate-with: python -c "import secrets; print(secrets.token_hex(32))">
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI
CLAUDE_API_KEY=<from-anthropic-console>
CLAUDE_MODEL=claude-sonnet-4-20250514

# Rate limiting + reverse proxy (round 8-16D)
# BOTH are enforced at boot when APP_ENV=production — the app refuses to
# start if either is missing/wrong. See docs/security.md §Rate limiting.
#
# RATE_LIMIT_STORAGE_URI — shared counter store. `memory://` is per-worker
#   and the image runs `uvicorn --workers 4`, so in-memory storage silently
#   multiplies every limit by 4 (and again by replica count). Point this at
#   the centralized Redis provided by Infra. Use rediss:// for TLS; include
#   credentials only if Infra requires them.
RATE_LIMIT_STORAGE_URI=redis://<redis-host>:6379/0
#
# TRUSTED_PROXY_IPS — comma-separated CIDRs of EVERY reverse-proxy hop in
#   front of this app, not just the nearest one. The request path is
#   client -> IT proxy -> frontend nginx container -> backend, and nginx
#   APPENDS to X-Forwarded-For, so the backend sees
#   "<real-client>, <IT-proxy-ip>" with the nginx container as its peer.
#   If the IT proxy's IP is omitted here, the resolver stops at that hop and
#   reports the PROXY as the client — every user lands in one bucket and the
#   limiter looks fine while protecting nothing. Ask Infra for both values;
#   do NOT paste the whole Docker bridge subnet, because proxy-net is shared
#   with other applications and any container on it could then spoof
#   X-Forwarded-For.
TRUSTED_PROXY_IPS=<nginx-container-cidr>,<it-proxy-ip>/32
#
# NOTE: RATE_LIMIT_PER_MINUTE was removed here in round 8-16D — the setting
# still exists in config.py but NO code reads it; per-route limits are
# declared with @limiter.limit("N/minute") at each endpoint. Leaving it in
# this template implied a global knob that does not exist.

# Postgres RLS runtime role (round 8-16D note).
# Empty = the app connects as DB_USER, the table OWNER. Five tables use
# FORCE ROW LEVEL SECURITY and stay protected regardless, but the remaining
# RLS policies are bypassed by an owner connection. Provision a non-owner
# role on the production database and set both values. Left blank here (not
# a boot gate) because whether that role exists is an Infra fact this
# template cannot assume — see docs/deployment.md.
DB_APP_USER=
DB_APP_PASSWORD=

# CT App Registry — ดู docs/ops/registry.md
# Required at L3; opt-in for L0/L1/L2. Set URL only when registering.
REGISTRY_URL=
REGISTRY_API_KEY=
PROJECT_SLUG=srm-fieldinspect
